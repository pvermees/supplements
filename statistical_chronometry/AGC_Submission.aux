\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Pairwise comparison of the original Pb--Pb dates of Table~\ref {tab:desch} with Al--Mg (panel~a), Mn--Cr (panel~b) and Hf--W (panel~c) dates for the same, rapidly cooled meteorites. The 1:1 lines were obtained using the optimal ${O}$-values (Equation~\ref {eq:A}). All three datasets are overdispersed around this line with respect to the analytical uncertainties (MSWD$\,\gg \,1$). $\omega $-values are the estimated standard deviations of the excess dispersion, assuming normality (Section~\ref {sec:discussion}). This dispersion can either be attributed to the Pb--Pb data, or to the initial $({}^{26}\mbox  {Al}/{}^{27}\mbox  {Al})_{\rm  SS}$, $({}^{53}\mbox  {Mn}/{}^{55}\mbox  {Mn})_{\rm  SS}$ or $({}^{182}\mbox  {Hf}/{}^{180}\mbox  {Hf})_{\rm  SS}$-values, or a combination. Uncertainties are reported as standard errors.}}{11}{figure.caption.3}\protected@file@percent }
\newlabel{fig:regression_original}{{2}{11}{Pairwise comparison of the original Pb--Pb dates of Table~\ref {tab:desch} with Al--Mg (panel~a), Mn--Cr (panel~b) and Hf--W (panel~c) dates for the same, rapidly cooled meteorites. The 1:1 lines were obtained using the optimal ${O}$-values (Equation~\ref {eq:A}). All three datasets are overdispersed around this line with respect to the analytical uncertainties (MSWD$\,\gg \,1$). $\omega $-values are the estimated standard deviations of the excess dispersion, assuming normality (Section~\ref {sec:discussion}). This dispersion can either be attributed to the Pb--Pb data, or to the initial $({}^{26}\mbox {Al}/{}^{27}\mbox {Al})_{\rm SS}$, $({}^{53}\mbox {Mn}/{}^{55}\mbox {Mn})_{\rm SS}$ or $({}^{182}\mbox {Hf}/{}^{180}\mbox {Hf})_{\rm SS}$-values, or a combination. Uncertainties are reported as standard errors}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Same as Figure~\ref {fig:regression_original}, but using the adjusted Pb--Pb dates of Table~\ref {tab:desch}.\vspace  \medskipamount }}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:regression_adjusted}{{3}{11}{Same as Figure~\ref {fig:regression_original}, but using the adjusted Pb--Pb dates of Table~\ref {tab:desch}.\medskip }{figure.caption.4}{}}
